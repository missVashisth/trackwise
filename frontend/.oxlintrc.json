{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "ignorePatterns": [
    "dist/**",
    "e2e/.dist/**",
    "e2e/.report/**",
    "e2e/.results/**"
  ],
  "overrides": [
    {
      "files": [
        "e2e/**"
      ],
      "rules": {
        "react/rules-of-hooks": "off",
        "react-hooks/rules-of-hooks": "off"
      }
    }
  ]
}
